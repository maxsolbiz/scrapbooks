# Template for .env.test (copy to .env.test and edit). .env.test itself is NOT committed.
# Only the `schema` and `sslmode` query parameters are allowed on the test URL — the
# db-guard rejects any other parameter name (query params can silently override
# host/port in pg-connection-string, e.g. ?host=prod.example.com).
DATABASE_URL_TEST=postgresql://CHANGE_ME:CHANGE_ME@localhost:54322/CHANGE_ME_test?schema=public
